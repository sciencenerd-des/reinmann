  apply CertifiedScalarExp.sound power21 power21_checks
  have hl : Contains (⟨((3044522437723423/1000000000000000),0),(3/500000000000000),by norm_num⟩ : Disk)
      (Real.log (21:ℝ) : ℂ) := by
    apply contains_real
    convert HardTileLogInputs.log_21 using 1 <;> norm_num
  have h := contains_mul (contains_exact ((-1/2 : ℚ),-14)) hl
  have hv : value ((-1/2 : ℚ),-14) = -((1/2 : ℂ)+14*Complex.I) := by
    norm_num [value]
    ring
  rw [hv] at h
  have hd : power21.input = mul (exact ((-1/2 : ℚ),-14))
      (⟨((3044522437723423/1000000000000000),0),(3/500000000000000),by norm_num⟩ : Disk) := by
