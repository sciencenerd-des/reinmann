def power2 : CertifiedScalarExp.Data :=
  ⟨⟨((-138629436111989/400000000000000), (-970406052783923/100000000000000)), (29/2000000000000000), by norm_num⟩, -2, power2Poly, power2Squares⟩

set_option maxHeartbeats 5000000 in
-- A bounded Horner table and six outward-rounded squarings.
theorem power2_checks : CertifiedScalarExp.Checks power2 := by
  constructor
  · norm_num [power2, CertifiedScalarExp.reduced, power2Poly, power2Squares,
      CertifiedScalarExp.piDisk, CertifiedTaylorModel.mul, CertifiedTaylorModel.add,
      exact, qmul, qadd, size]
  · rfl
  · intro k hk
    interval_cases k <;>
      norm_num [power2, CertifiedScalarExp.roundingCheck, CertifiedScalarExp.reduced,
        power2Poly, CertifiedScalarExp.piDisk, CertifiedTaylorModel.mul,
        CertifiedTaylorModel.add, exact, qmul, qadd, size]
  · apply CertifiedScalarExp.disk_ext <;> norm_num [power2, power2Squares, power2Poly, inflate]
  · intro k hk
    interval_cases k <;>
      norm_num [power2, CertifiedScalarExp.roundingCheck, power2Squares,
        CertifiedTaylorModel.mul, exact, qmul, qadd, size]

theorem power2_value : Contains (power2.squares 6)
    (Complex.exp (-((1/2 : ℂ)+14*Complex.I)*(Real.log (2:ℝ) : ℂ))) := by
  apply CertifiedScalarExp.sound power2 power2_checks
  have hl : Contains (⟨((138629436111989/200000000000000),0),(1/1000000000000000),by norm_num⟩ : Disk)
      (Real.log (2:ℝ) : ℂ) := by
    apply contains_real
    convert HardTileLogInputs.log_2 using 1 <;> norm_num
  have h := contains_mul (contains_exact ((-1/2 : ℚ),-14)) hl
  have hv : value ((-1/2 : ℚ),-14) = -((1/2 : ℂ)+14*Complex.I) := by
    norm_num [value]
    ring
  rw [hv] at h
  have hd : power2.input = mul (exact ((-1/2 : ℚ),-14))
      (⟨((138629436111989/200000000000000),0),(1/1000000000000000),by norm_num⟩ : Disk) := by
    apply CertifiedScalarExp.disk_ext <;>
      norm_num [power2, CertifiedTaylorModel.mul, exact, qmul, size]
  rw [hd]
  exact h

