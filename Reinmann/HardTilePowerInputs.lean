theorem power21_checks : CertifiedScalarExp.Checks power21 := by
  constructor
  · norm_num [power21, CertifiedScalarExp.reduced, power21Poly, power21Squares,
      CertifiedScalarExp.piDisk, CertifiedTaylorModel.mul, CertifiedTaylorModel.add,
      exact, qmul, qadd, size]
