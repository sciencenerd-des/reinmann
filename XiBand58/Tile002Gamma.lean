private theorem V_shiftInv : F_shift c=value ((431/32), (2403/320)) := by
  have h := centre_contains S_shift
  have he : J_shift ⟨0,by omega⟩=exact ((431/32), (2403/320)) := by
    apply CertifiedScalarExp.disk_ext <;> norm_num [J_shift,exact]
  rw [he] at h
