private theorem V_shiftInv : F_shift c=value ((2149/160), (5149/512)) := by
  have h := centre_contains S_shift
  have he : J_shift ⟨0,by omega⟩=exact ((2149/160), (5149/512)) := by
    apply CertifiedScalarExp.disk_ext <;> norm_num [J_shift,exact]
