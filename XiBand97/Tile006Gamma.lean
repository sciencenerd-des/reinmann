      apply Complex.ext <;> norm_num [value,Complex.inv_re,Complex.inv_im,Complex.normSq_apply]
    rw [hv]
    simpa [J_shiftInv] using contains_exact ((22005760/416410913), (-14071040/416410913))
  · intro n hn
    have hlt : n < 16 := by omega
