      apply Complex.ext <;> norm_num [value,Complex.inv_re,Complex.inv_im,Complex.normSq_apply]
    rw [hv]
    simpa [J_shiftInv] using contains_exact ((17604608/448313333), (-16664064/448313333))
  · intro n hn
